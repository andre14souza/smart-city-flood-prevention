  {
    "id": "func_simulate_readings",
    "type": "function",
    "z": "tab_smart_drains",
    "name": "Emulador de Sensor HC-SR04",
    "func": "// Lê modo compartilhado do fluxo\nlet mode = flow.get('sim_mode') || 'normal';\nlet currentDist = flow.get('current_dist') || 175.0;\n\nif (mode === 'critical') {\n    // Na enxurrada crítica, a água sobe mais e a distância diminui até 15-25cm\n    currentDist = Math.max(15.0, currentDist - 4.0 + (Math.random() * 2 - 1));\n} else {\n    // No tempo seco, a distância fica entre 165cm e 185cm (nível baixo de água)\n    currentDist = Math.min(180.0, currentDist + 5.0 + (Math.random() * 2 - 1));\n}\n\nflow.set('current_dist', currentDist);\n\nmsg.payload = {\n    sensor_id: 'bueiro_01',\n    distancia_cm: parseFloat(currentDist.toFixed(1)),\n    timestamp: Date.now()\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 140,
    "wires": [
      [
        "func_process_distance"
      ]
    ]
  },
