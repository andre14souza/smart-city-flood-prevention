  {
    "id": "func_process_distance",
    "type": "function",
    "z": "tab_smart_drains",
    "name": "Cálculo Hidrológico (Nível e Status)",
    "func": "const data = msg.payload;\nconst sensorDepth = 200.0;\nconst dist = typeof data.distancia_cm === 'number' ? data.distancia_cm : 200;\n\nlet waterLevelCm = sensorDepth - dist;\nif (waterLevelCm < 0) waterLevelCm = 0;\nif (waterLevelCm > sensorDepth) waterLevelCm = sensorDepth;\n\nlet waterLevelPct = parseFloat(((waterLevelCm / sensorDepth) * 100).toFixed(1));\n\nlet status = 'NORMAL';\nif (waterLevelPct >= 80) status = '🚨 CRÍTICO (TRANSBORDAMENTO)';\nelse if (waterLevelPct >= 50) status = '⚠️ ATENÇÃO (ELEVADO)';\nelse status = '🟢 NORMAL (SEGURO)';\n\nmsg.payload = {\n    sensor_id: data.sensor_id || 'bueiro_01',\n    distancia_cm: dist,\n    nivel_agua_cm: parseFloat(waterLevelCm.toFixed(1)),\n    nivel_agua_pct: waterLevelPct,\n    status: status\n};\n\nreturn [\n    { payload: waterLevelPct },\n    { payload: waterLevelPct, topic: 'Bueiro 01 (%)' },\n    { payload: status + ' [' + waterLevelPct + '% - ' + waterLevelCm.toFixed(1) + ' cm]' },\n    { payload: msg.payload }\n];",
    "outputs": 4,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 780,
    "y": 140,
    "wires": [
      [
        "ui_gauge_water"
      ],
      [
        "ui_chart_history"
      ],
      [
        "ui_text_status"
      ],
      []
    ]
  },
