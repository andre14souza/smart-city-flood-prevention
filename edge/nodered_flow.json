    "func": "flow.set('sim_mode', 'normal');\nflow.set('current_dist', 175.0);\n\nmsg.payload = {\n    sensor_id: 'bueiro_01',\n    distancia_cm: 175.0,\n    timestamp: Date.now()\n};\nreturn msg;",
