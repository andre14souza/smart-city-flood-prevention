  {
    "id": "func_trigger_critical",
    "type": "function",
    "z": "tab_smart_drains",
    "name": "Aplicar Imediato: Crítico",
    "func": "flow.set('sim_mode', 'critical');\nflow.set('current_dist', 24.0);\n\nmsg.payload = {\n    sensor_id: 'bueiro_01',\n    distancia_cm: 24.0,\n    timestamp: Date.now()\n};\nreturn msg;",
    "outputs": 1,
